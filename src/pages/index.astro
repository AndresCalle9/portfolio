---
// La raíz redirige al idioma del navegador; sin JavaScript, a español.
const es = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/es/`;
const en = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/en/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Andrés Calle Uribe</title>
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="en" href={en} />
    <script is:inline define:vars={{ es, en }}>
      location.replace(/^es\b/i.test(navigator.language) ? es : en);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${es}`} /></noscript>
  </head>
  <body>
    <p><a href={es}>Español</a> · <a href={en}>English</a></p>
  </body>
</html>
